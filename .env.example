NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=.data/cipi.sqlite
UPLOAD_DIR=uploads
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# On the first start only, set these two to securely create the first administrator.
# Remove them after setup. Alternatively run: npm run setup:admin -- admin@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true on the first start to load the four supplied CIPI vehicles and photos.
SEED_FLEET=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rentacarcipi@gmail.com
